{
  "name": "@agentbus/core",
  "version": "0.1.0",
  "description": "Agent Message Bus — discover, communicate, wake, and remember across heterogeneous AI agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentbus": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "agent",
    "message-bus",
    "a2a",
    "multi-agent",
    "cli",
    "orchestration",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "drizzle-orm": "^0.45.0",
    "eventemitter3": "^5.0.1",
    "gray-matter": "^4.0.3",
    "nats": "^2.28.0",
    "ora": "^8.1.0",
    "uuid": "^10.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module"
}
